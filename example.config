# bicchierino config — una direttiva per riga, il primo token la seleziona.
# Riga vuota o che inizia con # ignorata.
#
# Path di default: ./bicchierino.config (CWD). Override con --config <path>.

# --- grappa -----------------------------------------------------------
# Deployment grappa a cui questo processo fa da bridge. Obbligatoria, una sola.
grappa-url https://grappa.example.net

# --- listener IRC a valle ----------------------------------------------
# Ripetibile: un bicchierino può ascoltare su più (ip, porta, tls) insieme.
#   bind <ip> <porta> plain
#   bind <ip> <porta> tls <cert.pem> <key.pem>
#
# Un bind con ip non-loopback e "plain" viene RIFIUTATO all'avvio a meno
# di non passare --insecure sulla riga di comando: la password grappa di
# ogni client viaggia dentro PASS, in chiaro fuori da TLS è un secret vero
# esposto in rete.
bind 127.0.0.1 6667 plain
bind 0.0.0.0 6697 tls /etc/bicchierino/cert.pem /etc/bicchierino/key.pem

# --- logging ------------------------------------------------------------
# Opzionale. Assente = solo stderr. Gli errori vanno SEMPRE anche su stderr
# oltre che sul file, se un file è configurato. Mai traffico IRC/JSON qui,
# nemmeno a questo livello — quello esiste solo nella build di debug.
log-file /var/log/bicchierino/bicchierino.log
