# bicchierino config — one directive per line, the first token selects it.
# A blank line or one starting with # is ignored.
#
# Default path: ./bicchierino.config (CWD). Override with --config <path>.

# --- grappa -----------------------------------------------------------
# The grappa deployment this process bridges to. Required, exactly one.
grappa-url https://grappa.example.net

# --- downstream IRC listener --------------------------------------------
# Repeatable: one bicchierino process can listen on several (ip, port, tls)
# combinations at once.
#   bind <ip> <port> plain
#   bind <ip> <port> tls <cert.pem> <key.pem>
#
# A bind on a non-loopback ip with "plain" is REFUSED at startup unless
# --insecure is passed on the command line: every client's grappa password
# travels inside PASS, and in the clear off loopback that's a real secret
# exposed on the network.
bind 127.0.0.1 6667 plain
bind 0.0.0.0 6697 tls /etc/bicchierino/cert.pem /etc/bicchierino/key.pem

# --- logging ------------------------------------------------------------
# Optional. Absent = stderr only. Errors ALWAYS also go to stderr, in
# addition to the file if one is configured. Never IRC/JSON traffic here,
# not even at this level — that only exists in the debug build.
log-file /var/log/bicchierino/bicchierino.log
