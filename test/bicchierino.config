# bicchierino config for the sealed test stack.

# nginx terminates TLS in front of grappa under this name. https is not a
# choice here: parse_grappa_url refuses every other scheme.
grappa-url https://grappa-tls

# Reachable to the rest of the sealed stack, so weechat can connect from
# its own container. `plain` off loopback normally refuses to start —
# every client's grappa password rides inside PASS and would be in the
# clear — which is why the container passes --insecure.
#
# That override is defensible ONLY because of where this runs: every
# network in this stack is `internal: true`, no port is published, and the
# only peer is the weechat container. The moment either of those stops
# being true, this line is a credential on the wire and the config wants a
# `tls` bind with a real cert instead.
bind 0.0.0.0 6667 plain
