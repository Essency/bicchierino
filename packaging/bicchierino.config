# bicchierino config — one directive per line, the first token selects it.
# A blank line or one starting with # is ignored. See
# /usr/share/doc/bicchierino/README.md for the full directive reference.
#
# grappa-url is REQUIRED — replace the placeholder below before starting
# the service (systemd will not start bicchierino automatically on
# install for exactly this reason: the placeholder can never connect).
grappa-url https://your-grappa-instance.example

# Repeatable — one bicchierino process can listen on several (ip, port,
# tls) combinations at once. A non-loopback "plain" bind is refused at
# startup unless --insecure is passed: every client's grappa password
# travels inside PASS, and that is a real secret exposed on the network
# if sent in the clear off loopback.
bind 127.0.0.1 6667 plain

# No log-file directive: under systemd, stderr is already captured by
# the journal (see `journalctl -u bicchierino`) — a separate log file
# would just be a second copy of the same lines to manage.
